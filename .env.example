# ==============================================================================
# GoalCast AI — Environment Variables ($0/Month Vercel + Vercel Blob + Neon Stack)
# Copy this file to .env for local development, and add the same variables to
# Vercel Project Settings and GitHub Actions Repository Secrets.
# ==============================================================================

# 1. Runtime URL (Used for YouTube OAuth callback construction)
APP_URL="http://localhost:3000"

# 2. Google Gemini API (Free tier / AI Studio key — AI Title, Description & Synced Commentary)
GEMINI_API_KEY=""

# 3. Neon Serverless PostgreSQL (Free tier — Backlog Queue & OAuth Tokens)
# Example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# 4. Vercel Blob Temporary Video Storage (Free Hobby tier — Client Uploads & Auto Cleanup)
# Created automatically when you add a Blob Store to your Vercel project.
BLOB_READ_WRITE_TOKEN=""

# 5. YouTube Data API v3 OAuth 2.0 (Free — Automated Shorts Publishing)
# Authorized redirect URI must be: ${APP_URL}/auth/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI=""
# Default visibility for published Shorts: public | unlisted | private
YOUTUBE_PRIVACY_STATUS="public"

# 6. Passionate Voiceover AI (ElevenLabs Free Tier Primary + Automatic Free Edge TTS Fallback)
# Leave ELEVENLABS_API_KEY empty to automatically use free unlimited Edge TTS.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="pNInz6obpgDQGcFmaJgB"
EDGE_TTS_VOICE="en-GB-RyanNeural"
